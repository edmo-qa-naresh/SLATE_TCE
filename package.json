{
  "name": "slate-tce-playwright",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:ocr": "playwright test tests/ocr.spec.ts --project=ocr-chromium --headed --workers=2",
    "test:e2e:tce-dashboard": "playwright test tests/tce.spec.ts --project=tce-dashboard-chromium --headed --workers=2",
    "test:e2e:tce-flow": "playwright test --project=tce-dashboard-chromium --headed --workers=1",
    "test:e2e:auth": "playwright test --project=auth-setup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^16.4.5",
    "typescript": "^7.0.2"
  }
}