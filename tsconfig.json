{
    "compilerOptions": {
        "target": "ES2022",
        "moduleResolution": "Node16",
        "module": "Node16",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "playwright.config.ts",
        "tests/**/*.ts",
        "src/**/*.ts"
    ]
}